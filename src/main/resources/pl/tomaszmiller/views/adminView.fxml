<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="600.0" minWidth="800.0"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="pl.tomaszmiller.controllers.AdminController">
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 16; -fx-background-color: #002244;">
            <Label fx:id="welcomeLabel" text="%nav.admin" style="-fx-text-fill: #b3995d; -fx-font-size: 14px;"
                   HBox.hgrow="ALWAYS"/>
            <Button text="%nav.logout" onAction="#onLogout"
                    style="-fx-background-color: #b3995d; -fx-text-fill: #002244; -fx-padding: 6 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="%tab.users">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 12;">
                            <Label fx:id="userCountLabel" text="%tab.users" style="-fx-font-size: 14px;"/>
                            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="userIdCol" text="%col.id" prefWidth="50"/>
                                    <TableColumn fx:id="userNameCol" text="%col.fullname" prefWidth="200"/>
                                    <TableColumn fx:id="userEmailCol" text="%col.email" prefWidth="240"/>
                                    <TableColumn fx:id="userRoleCol" text="%col.role" prefWidth="90"/>
                                </columns>
                            </TableView>
                            <HBox spacing="8">
                                <Button fx:id="deleteUserBtn" text="%admin.users.remove" onAction="#onDeleteUser"
                                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 6 12;"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="%tab.rentals">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 12;">
                            <TableView fx:id="rentalsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="rentalIdCol" text="%col.id" prefWidth="50"/>
                                    <TableColumn fx:id="rentalUserCol" text="%col.user" prefWidth="150"/>
                                    <TableColumn fx:id="rentalBookCol" text="%col.book" prefWidth="200"/>
                                    <TableColumn fx:id="rentalBorrowCol" text="%col.borrowed" prefWidth="110"/>
                                    <TableColumn fx:id="rentalDueCol" text="%col.duedate" prefWidth="110"/>
                                    <TableColumn fx:id="rentalStatusCol" text="%col.status" prefWidth="110"/>
                                </columns>
                            </TableView>
                            <HBox spacing="8">
                                <Button fx:id="returnBookBtn" text="%admin.rentals.return" onAction="#onReturnBook"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 6 12;"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="%tab.bookcatalog">
                    <content>
                        <GridPane>
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="55"/>
                                <ColumnConstraints hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10" vgrow="ALWAYS"/>
                            </rowConstraints>
                            <children>
                                <VBox spacing="6" style="-fx-padding: 10;">
                                    <HBox spacing="6">
                                        <TextField fx:id="searchField" promptText="%search.prompt" HBox.hgrow="ALWAYS"/>
                                        <Button text="%search.button" onAction="#onSearchBook"
                                                style="-fx-background-color: #002244; -fx-text-fill: white; -fx-padding: 6 10;"/>
                                    </HBox>
                                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                                        <content>
                                            <ListView fx:id="theList"/>
                                        </content>
                                    </ScrollPane>
                                </VBox>
                                <VBox spacing="10" style="-fx-padding: 10;" GridPane.columnIndex="1">
                                    <Label text="%book.details" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                                    <Label text="%book.author" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookAuthor" promptText="%book.author.prompt"/>
                                    <Label text="%book.title" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookTitle" promptText="%book.title.prompt"/>
                                    <Label text="%book.pages" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="pages" promptText="%book.pages.prompt"/>
                                    <Label text="%book.isbn" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookIsbn" promptText="%book.isbn.prompt"/>
                                    <Label text="%book.year" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookYear" promptText="%book.year.prompt"/>
                                    <Label text="%book.publisher" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookPublisher" promptText="%book.publisher.prompt"/>
                                    <HBox spacing="8">
                                        <Button fx:id="addBookBtn" text="%admin.books.add" onAction="#onAddBook"
                                                style="-fx-background-color: #002244; -fx-text-fill: white; -fx-padding: 6 10;"/>
                                        <Button fx:id="deleteBookBtn" text="%admin.books.remove"
                                                onAction="#onDeleteBook"
                                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 6 10;"/>
                                    </HBox>
                                </VBox>
                            </children>
                        </GridPane>
                    </content>
                </Tab>

                <Tab text="%tab.extensions">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 12;">
                            <Label text="%admin.ext.title" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <TableView fx:id="extRequestsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="extReqIdCol" text="%col.id" prefWidth="50"/>
                                    <TableColumn fx:id="extReqUserCol" text="%col.user" prefWidth="150"/>
                                    <TableColumn fx:id="extReqBookCol" text="%col.book" prefWidth="200"/>
                                    <TableColumn fx:id="extReqDateCol" text="%col.requestdate" prefWidth="110"/>
                                    <TableColumn fx:id="extReqStatusCol" text="%col.status" prefWidth="100"/>
                                </columns>
                            </TableView>
                            <HBox spacing="8">
                                <Button text="%admin.ext.approve" onAction="#onApproveExtension"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 6 12;"/>
                                <Button text="%admin.ext.reject" onAction="#onRejectExtension"
                                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 6 12;"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="%tab.reservations">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 12;">
                            <Label text="%admin.res.title" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <TableView fx:id="reservationsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="resIdCol" text="%col.id" prefWidth="50"/>
                                    <TableColumn fx:id="resUserCol" text="%col.user" prefWidth="150"/>
                                    <TableColumn fx:id="resBookCol" text="%col.book" prefWidth="200"/>
                                    <TableColumn fx:id="resDateCol" text="%col.requestdate" prefWidth="110"/>
                                    <TableColumn fx:id="resStatusCol" text="%col.status" prefWidth="100"/>
                                </columns>
                            </TableView>
                            <HBox spacing="8">
                                <Button text="%admin.res.approve" onAction="#onApproveReservation"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 6 12;"/>
                                <Button text="%admin.res.reject" onAction="#onRejectReservation"
                                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 6 12;"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
