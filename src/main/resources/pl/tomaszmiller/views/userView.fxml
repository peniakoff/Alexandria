<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="600.0" minWidth="800.0"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="pl.tomaszmiller.controllers.UserController">
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 16; -fx-background-color: #002244;">
            <Label fx:id="welcomeLabel" text="%nav.welcome" style="-fx-text-fill: #b3995d; -fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
            <Button text="%nav.logout" onAction="#onLogout"
                    style="-fx-background-color: #b3995d; -fx-text-fill: #002244; -fx-padding: 6 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="%tab.myrentals">
                    <content>
                        <VBox spacing="8.0" style="-fx-padding: 12;">
                            <Label text="%tab.myrentals" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <TableView fx:id="myRentalsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="myRentalIdCol" text="%col.id" prefWidth="50"/>
                                    <TableColumn fx:id="myRentalBookCol" text="%col.title" prefWidth="250"/>
                                    <TableColumn fx:id="myRentalBorrowCol" text="%col.borrowed" prefWidth="100"/>
                                    <TableColumn fx:id="myRentalDueCol" text="%col.duedate" prefWidth="100"/>
                                    <TableColumn fx:id="myRentalStatusCol" text="%col.status" prefWidth="100"/>
                                    <TableColumn fx:id="myRentalActionCol" text="%col.action" prefWidth="140"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="%tab.borrow">
                    <content>
                        <GridPane>
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="55"/>
                                <ColumnConstraints hgrow="SOMETIMES"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10" vgrow="ALWAYS"/>
                            </rowConstraints>
                            <children>
                                <VBox spacing="6" style="-fx-padding: 10;">
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <TextField fx:id="searchField" promptText="%search.prompt" HBox.hgrow="ALWAYS"/>
                                        <Button text="%search.button" onAction="#onSearchBook"
                                                style="-fx-background-color: #002244; -fx-text-fill: white; -fx-padding: 6 10;"/>
                                    </HBox>
                                    <CheckBox fx:id="showUnavailableCheck" text="%search.showunavailable" onAction="#onToggleShowUnavailable"/>
                                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                                        <content>
                                            <ListView fx:id="theList"/>
                                        </content>
                                    </ScrollPane>
                                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                                        <Label text="%search.perpage"/>
                                        <ComboBox fx:id="pageSizeCombo"/>
                                        <Button fx:id="prevPageBtn" text="%search.prev" onAction="#onPrevPage"
                                                style="-fx-padding: 4 8;"/>
                                        <Label fx:id="pageInfoLabel" text="%search.page"/>
                                        <Button fx:id="nextPageBtn" text="%search.next" onAction="#onNextPage"
                                                style="-fx-padding: 4 8;"/>
                                    </HBox>
                                </VBox>
                                <VBox spacing="10" style="-fx-padding: 10;" GridPane.columnIndex="1">
                                    <Label text="%book.details" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                                    <Label text="%book.author" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookAuthor" editable="false" promptText="%book.author.prompt"/>
                                    <Label text="%book.title" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookTitle" editable="false" promptText="%book.title.prompt"/>
                                    <Label text="%book.pages" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="pages" editable="false" promptText="%book.pages.prompt"/>
                                    <Label text="%book.isbn" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookIsbn" editable="false" promptText="%book.isbn.prompt"/>
                                    <Label text="%book.year" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookYear" editable="false" promptText="%book.year.prompt"/>
                                    <Label text="%book.publisher" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookPublisher" editable="false" promptText="%book.publisher.prompt"/>
                                    <Label text="%book.status" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                                    <TextField fx:id="bookStatus" editable="false" promptText="%col.status"/>
                                    <HBox spacing="8">
                                        <Button fx:id="borrowBtn" text="%borrow.button" onAction="#onBorrowBook"
                                                style="-fx-background-color: #b3995d; -fx-padding: 8 14;"/>
                                        <Button fx:id="reserveBtn" text="%borrow.reserve" onAction="#onReserveBook"
                                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 14;"/>
                                    </HBox>
                                </VBox>
                            </children>
                        </GridPane>
                    </content>
                </Tab>

                <Tab text="%tab.settings">
                    <content>
                        <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #EEEEEE;">
                            <Label text="%settings.profile" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25" halignment="RIGHT"/>
                                    <ColumnConstraints percentWidth="55"/>
                                </columnConstraints>
                                <Label text="%settings.firstname" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingsFirstName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="%settings.lastname" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingsLastName" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="%settings.phone" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="settingsPhone" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Label text="%settings.changepass" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25" halignment="RIGHT"/>
                                    <ColumnConstraints percentWidth="55"/>
                                </columnConstraints>
                                <Label text="%settings.newpass" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="settingsNewPassword" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="%settings.newpass.prompt"/>
                                <Label text="%settings.confirmpass" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="settingsConfirmPassword" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="%settings.confirmpass.prompt"/>
                            </GridPane>

                            <Button fx:id="saveSettingsBtn" text="%settings.save" onAction="#onSaveSettings"
                                    style="-fx-background-color: #002244; -fx-text-fill: white; -fx-padding: 8 20;"/>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
